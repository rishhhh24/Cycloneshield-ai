# CycloneShield AI - Environment Configuration Example
# Copy this file to .env and populate actual values before running.

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_PATH=database/cycloneshield.db

# Geospatial Settings
DEFAULT_BUFFER_DISTANCE_KM=50.0
MAX_SIMULATION_WIND_INCREASE_KNOTS=50
