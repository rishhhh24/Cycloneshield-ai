# CycloneShield AI - Environment Configuration Template
# Copy this file to .env and insert your configuration before running.

FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000

# Google Gemini API Key (Optional: grounded fallback service executes offline if key is not supplied)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_PATH=backend/database/cycloneshield.db

# Geospatial Settings
DEFAULT_BUFFER_DISTANCE_KM=50.0
MAX_SIMULATION_WIND_INCREASE_KNOTS=50
